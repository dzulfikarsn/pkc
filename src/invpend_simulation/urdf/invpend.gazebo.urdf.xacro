<?xml version="1.0" encoding="UTF-8"?>
<robot name="invpend" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find invpend_description)/urdf/invpend.description.xacro" />
  <xacro:include filename="$(find invpend_simulation)/urdf/invpend.gazebo.ros2_control.xacro" />

  <xacro:invpend_description />
  <xacro:invpend_gazebo_ros2_control />

  <!--
    Gangguan torsi ke pole (Nm), di luar ros2_control.
    gz topic : /model/invpend/joint/cart_to_pole/cmd_force (gz.msgs.Double)
    ROS topic: /pole/disturbance (std_msgs/msg/Float64), lihat invpend.bridge.yaml
    Nilai terakhir terus diterapkan sampai dikirim 0.
  -->
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>cart_to_pole</joint_name>
    </plugin>
  </gazebo>

</robot>
